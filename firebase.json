{
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/@(authorize|token|register|revoke|mcp)",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/mcp/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/mcp", "function": "mcpServer" },
      { "source": "/mcp/**", "function": "mcpServer" },
      { "source": "/authorize", "function": "mcpServer" },
      { "source": "/token", "function": "mcpServer" },
      { "source": "/register", "function": "mcpServer" },
      { "source": "/revoke", "function": "mcpServer" },
      { "source": "/.well-known/oauth-authorization-server", "function": "mcpServer" },
      { "source": "/.well-known/oauth-protected-resource", "function": "mcpServer" },
      { "source": "/.well-known/oauth-protected-resource/**", "function": "mcpServer" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "olympus-web",
        "supportEmail": "support@bcoletech.com"
      }
    }
  }
}
