rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function hasApp(appId) {
      return request.auth != null
          && request.auth.token.apps is list
          && appId in request.auth.token.apps;
    }

    function hasAdmin() {
      return request.auth != null
          && request.auth.token.admin == true;
    }

    // ── The Symposium ──────────────────────────────────────

    match /symposium_ingredients/{ingredientId} {
      function validIngredient() {
        let data = request.resource.data;
        let required = [
          'name', 'category', 'subcategory', 'tags',
          'unit', 'type', 'inStock', 'quantity',
          'trackingType', 'stock', 'bottleSize', 'bottleSizeUnit',
          'notes', 'shoppingListDefault', 'lowStockThreshold',
          'createdAt', 'updatedAt'
        ];
        let allowed = [
          'name', 'category', 'subcategory', 'tags',
          'unit', 'type', 'inStock', 'quantity',
          'trackingType', 'restockUnit', 'stock', 'bottleSize', 'bottleSizeUnit',
          'notes', 'shoppingListDefault', 'lowStockThreshold',
          'createdAt', 'updatedAt', 'openBottleLevel', 'brand'
        ];
        let validLevels = ['full', 'three-quarter', 'half', 'quarter', 'empty'];

        return data.keys().hasAll(required)
            && data.keys().hasOnly(allowed)
            && data.type == 'consumable'
            && data.unit in ['oz', 'ml', 'dash', 'each', 'splash']
            && data.trackingType in ['volume', 'quantity']
            && (!data.keys().hasAny(['restockUnit']) || (
                 (data.trackingType == 'quantity' && data.restockUnit == 'each') ||
                 (data.trackingType == 'volume' && data.restockUnit in ['bottle', 'can', 'box', 'bag', 'pack'])
               ))
            && data.stock is int && data.stock >= 0
            && data.bottleSize is number && data.bottleSize >= 0
            && data.bottleSizeUnit in ['ml', 'oz']
            && exists(/databases/$(database)/documents/symposium_categories/$(data.category))
            && (!data.keys().hasAny(['openBottleLevel']) || data.openBottleLevel in validLevels)
            && (!data.keys().hasAny(['brand'])
                || (data.brand is string && data.brand.size() <= 200));
      }

      allow read: if hasApp('symposium');
      allow create: if hasApp('symposium')
                    && validIngredient()
                    && request.resource.data.keys().hasAny(['restockUnit'])
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if hasApp('symposium')
                    && validIngredient()
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if hasApp('symposium');
    }

    match /symposium_equipment/{equipmentId} {
      function validEquipment() {
        let data = request.resource.data;
        let required = [
          'name', 'category', 'subcategory', 'tags',
          'type', 'quantity', 'condition',
          'notes', 'createdAt', 'updatedAt'
        ];
        let allowed = required;
        let validConditions = ['good', 'fair', 'replace'];

        return data.keys().hasAll(required)
            && data.keys().hasOnly(allowed)
            && data.type == 'reusable'
            && data.condition in validConditions
            && exists(/databases/$(database)/documents/symposium_categories/$(data.category));
      }

      allow read: if hasApp('symposium');
      allow create: if hasApp('symposium')
                    && validEquipment()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if hasApp('symposium')
                    && validEquipment()
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if hasApp('symposium');
    }

    match /symposium_recipes/{recipeId} {
      // ── Ingredient ref helpers ────────────────────────────────────────
      // NOTE: Firestore Security Rules cannot iterate variable-length lists.
      // These helpers are applied only to ingredients[0] / equipment[0] as a
      // spot-check. Full per-item validation is enforced by the frontend.

      function validLinkedIngredient(item) {
        return item.keys().hasAll(['id', 'amount', 'unit', 'optional'])
            && item.keys().hasOnly(['id', 'amount', 'unit', 'optional'])
            && item.id is string && item.id.size() > 0
            && item.amount is string
            && item.unit is string && item.unit.size() > 0
            && item.optional is bool;
      }

      function validPendingIngredient(item) {
        return item.keys().hasAll(['name', 'amount', 'unit', 'optional', 'pending'])
            && item.keys().hasOnly(['name', 'amount', 'unit', 'optional', 'pending'])
            && item.name is string && item.name.size() > 0 && item.name.size() <= 200
            && item.amount is string
            && item.unit is string && item.unit.size() > 0
            && item.optional is bool
            && item.pending == true;
      }

      function validIngredientItem(item) {
        return 'pending' in item
            ? validPendingIngredient(item)
            : validLinkedIngredient(item);
      }

      // ── Equipment ref helpers ─────────────────────────────────────────

      function validLinkedEquipment(item) {
        return item.keys().hasAll(['id']) && item.keys().hasOnly(['id'])
            && item.id is string && item.id.size() > 0;
      }

      function validPendingEquipment(item) {
        return item.keys().hasAll(['name', 'pending'])
            && item.keys().hasOnly(['name', 'pending'])
            && item.name is string && item.name.size() > 0 && item.name.size() <= 200
            && item.pending == true;
      }

      function validEquipmentItem(item) {
        return 'pending' in item
            ? validPendingEquipment(item)
            : validLinkedEquipment(item);
      }

      function validRecipe() {
        let data = request.resource.data;
        let required = [
          'name', 'category', 'subcategory', 'tags',
          'description', 'instructions', 'ingredients', 'equipment',
          'garnish', 'glassware', 'servings', 'canMake',
          'favorite', 'createdAt', 'updatedAt'
        ];
        let allowed = [
          'name', 'category', 'subcategory', 'tags',
          'description', 'instructions', 'ingredients', 'equipment',
          'garnish', 'glassware', 'servings', 'canMake',
          'imageUrl', 'source', 'pendingCount', 'favorite', 'createdAt', 'updatedAt'
        ];

        let cat = get(/databases/$(database)/documents/symposium_categories/$(data.category)).data;

        return data.keys().hasAll(required)
            && data.keys().hasOnly(allowed)
            // numeric / boolean fields
            && data.servings is int
            && data.servings > 0
            && data.canMake is bool
            && data.favorite is bool
            // core string fields
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 200
            && data.subcategory is string
            && data.subcategory.size() > 0
            && data.subcategory.size() <= 100
            && data.description is string
            && data.description.size() > 0
            && data.description.size() <= 5000
            && data.instructions is string
            && data.instructions.size() > 0
            && data.instructions.size() <= 5000
            && data.garnish is string
            && data.garnish.size() <= 1000
            && data.glassware is string
            && data.glassware.size() > 0
            && data.glassware.size() <= 200
            // optional string fields
            && (!data.keys().hasAny(['imageUrl'])
                || (data.imageUrl is string
                    && data.imageUrl.size() > 0
                    && data.imageUrl.size() <= 2000))
            && (!data.keys().hasAny(['source'])
                || (data.source is string
                    && data.source.size() > 0
                    && data.source.size() <= 2000))
            // pendingCount: optional, non-negative integer
            && (!data.keys().hasAny(['pendingCount'])
                || (data.pendingCount is int && data.pendingCount >= 0))
            // list fields — size bounds enforced for all; first-item shape spot-checked
            && data.ingredients is list
            && data.ingredients.size() <= 200
            && (data.ingredients.size() == 0
                || validIngredientItem(data.ingredients[0]))
            && data.equipment is list
            && data.equipment.size() <= 200
            && (data.equipment.size() == 0
                || validEquipmentItem(data.equipment[0]))
            && data.tags is list
            && data.tags.size() <= 200
            // category must be a recipe category with valid subcategory
            && cat.type == 'recipe'
            && data.subcategory in cat.subcategories;
      }

      allow read: if hasApp('symposium');
      allow create: if hasApp('symposium')
                    && validRecipe()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if hasApp('symposium')
                    && validRecipe()
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if hasApp('symposium');
    }

    match /symposium_shopping_list/{itemId} {
      function validShoppingListItem() {
        let data = request.resource.data;
        let required = [
          'name', 'quantity', 'unit', 'category', 'checked',
          'addedFrom', 'ingredientId', 'sourceRecipeId', 'notes',
          'createdAt', 'updatedAt'
        ];
        let allowed = required;
        let validSources = ['manual', 'auto-suggest', 'recipe'];

        return data.keys().hasAll(required)
            && data.keys().hasOnly(allowed)
            && data.name is string && data.name.size() > 0 && data.name.size() <= 200
            && data.quantity is number && data.quantity >= 0
            && data.unit is string && data.unit.size() <= 50
            && data.category is string && data.category.size() <= 100
            && data.checked is bool
            && data.addedFrom in validSources
            && (data.ingredientId == null
                || (data.ingredientId is string && data.ingredientId.size() > 0))
            && (data.sourceRecipeId == null
                || (data.sourceRecipeId is string && data.sourceRecipeId.size() > 0))
            && data.notes is string && data.notes.size() <= 1000;
      }

      allow read: if hasApp('symposium');
      allow create: if hasApp('symposium')
                    && validShoppingListItem()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if hasApp('symposium')
                    && validShoppingListItem()
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if hasApp('symposium');
    }

    match /symposium_categories/{categoryId} {
      function validCategory() {
        let data = request.resource.data;
        let required = ['name', 'type', 'subcategories', 'sortOrder'];
        let validTypes = ['ingredient', 'equipment', 'recipe'];

        return data.keys().hasAll(required)
            && data.keys().hasOnly(required)
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 200
            && data.type in validTypes
            && data.subcategories is list
            && data.subcategories.size() <= 100
            && (data.subcategories.size() == 0
                || (data.subcategories[0] is string
                    && data.subcategories[0].size() > 0
                    && data.subcategories[0].size() <= 200))
            && (data.type != 'recipe' || data.subcategories.size() > 0)
            && data.sortOrder is int
            && data.sortOrder >= 0;
      }

      allow read: if hasApp('symposium');
      allow create: if hasApp('symposium') && validCategory();
      allow update: if hasApp('symposium')
                    && validCategory()
                    && request.resource.data.type == resource.data.type;
      allow delete: if hasApp('symposium');
    }

    // ── Void Odyssey ──────────────────────────────────────

    match /void_odyssey_games/{gameId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.userId
        && hasApp('void-odyssey');

      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && hasApp('void-odyssey');

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && hasApp('void-odyssey');

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/void_odyssey_games/$(gameId)).data.userId == request.auth.uid
          && hasApp('void-odyssey');
      }
    }

    // ── App registry ──────────────────────────────────────

    match /apps/{appId} {
      allow read: if hasApp(appId) || hasAdmin();
    }

    // ── Pool Handicap Tracker ─────────────────────────────

    match /pool_handicap/{userId} {
      function validPoolHandicap() {
        let data = request.resource.data;
        return data.keys().hasAll(['players', 'matches'])
            && data.keys().hasOnly(['players', 'matches'])
            && data.players is list
            && data.players.size() <= 100
            && data.matches is list
            && data.matches.size() <= 500;
      }

      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
          && request.auth.uid == userId
          && validPoolHandicap();
    }

    // ── Default deny ───────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
